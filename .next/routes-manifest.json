{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "euromarket-ro.com"
        }
      ],
      "destination": "https://www.euromarket-ro.com/:path*",
      "statusCode": 308,
      "regex": "^(?!/_next)(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/images/hero-bg.webp",
      "destination": "/images/statie-epurare-ape-uzate.webp",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/hero-bg\\.webp(?:/)?$"
    },
    {
      "source": "/images/office.jpg",
      "destination": "/images/sediu-euromarket-iasi.jpg",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/office\\.jpg(?:/)?$"
    },
    {
      "source": "/images/municipal_600_mc.webp",
      "destination": "/images/statie-epurare-municipala-600-mc.webp",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/municipal_600_mc\\.webp(?:/)?$"
    },
    {
      "source": "/images/sbr.jpeg",
      "destination": "/images/statie-epurare-industriala-sbr.jpeg",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/sbr\\.jpeg(?:/)?$"
    },
    {
      "source": "/images/industrial_1.jpeg",
      "destination": "/images/hala-statie-epurare-industriala-daf.jpeg",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/industrial_1\\.jpeg(?:/)?$"
    },
    {
      "source": "/images/industrial_2.jpeg",
      "destination": "/images/unitate-flotatie-daf.jpeg",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/industrial_2\\.jpeg(?:/)?$"
    },
    {
      "source": "/images/productie.jpeg",
      "destination": "/images/decantor-inox-statie-epurare.jpeg",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/productie\\.jpeg(?:/)?$"
    },
    {
      "source": "/images/productie_1.jpeg",
      "destination": "/images/montaj-bazin-inox-statie-epurare.jpeg",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/productie_1\\.jpeg(?:/)?$"
    },
    {
      "source": "/images/productie_2.jpeg",
      "destination": "/images/amplasare-statie-epurare-containerizata.jpeg",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/productie_2\\.jpeg(?:/)?$"
    },
    {
      "source": "/images/productie_3.jpeg",
      "destination": "/images/statie-epurare-containerizata-euromarket.jpeg",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/productie_3\\.jpeg(?:/)?$"
    },
    {
      "source": "/images/productie_4.jpeg",
      "destination": "/images/fabricatie-unitati-flotatie-daf.jpeg",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/productie_4\\.jpeg(?:/)?$"
    },
    {
      "source": "/images/productie_5.jpeg",
      "destination": "/images/transport-echipamente-statie-epurare.jpeg",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/productie_5\\.jpeg(?:/)?$"
    },
    {
      "source": "/images/scada_2.jpeg",
      "destination": "/images/scada-monitorizare-statie-epurare.jpeg",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/scada_2\\.jpeg(?:/)?$"
    },
    {
      "source": "/images/scada_1.webp",
      "destination": "/images/tablou-automatizare-statie-epurare.webp",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/scada_1\\.webp(?:/)?$"
    },
    {
      "source": "/index.htm",
      "destination": "/",
      "statusCode": 308,
      "regex": "^(?!/_next)/index\\.htm(?:/)?$"
    },
    {
      "source": "/contact.htm",
      "destination": "/#contact",
      "statusCode": 308,
      "regex": "^(?!/_next)/contact\\.htm(?:/)?$"
    },
    {
      "source": "/echipamente.htm",
      "destination": "/#technologies",
      "statusCode": 308,
      "regex": "^(?!/_next)/echipamente\\.htm(?:/)?$"
    },
    {
      "source": "/servicii.htm",
      "destination": "/#services",
      "statusCode": 308,
      "regex": "^(?!/_next)/servicii\\.htm(?:/)?$"
    },
    {
      "source": "/despre.htm",
      "destination": "/#about",
      "statusCode": 308,
      "regex": "^(?!/_next)/despre\\.htm(?:/)?$"
    },
    {
      "source": "/portofoliu.htm",
      "destination": "/#portfolio",
      "statusCode": 308,
      "regex": "^(?!/_next)/portofoliu\\.htm(?:/)?$"
    },
    {
      "source": "/aplicatii.htm",
      "destination": "/#applications",
      "statusCode": 308,
      "regex": "^(?!/_next)/aplicatii\\.htm(?:/)?$"
    },
    {
      "source": "/:path*.htm",
      "destination": "/",
      "statusCode": 308,
      "regex": "^(?!/_next)(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?\\.htm(?:/)?$"
    },
    {
      "source": "/terms",
      "destination": "/privacy",
      "statusCode": 308,
      "regex": "^(?!/_next)/terms(?:/)?$"
    },
    {
      "source": "/termeni",
      "destination": "/privacy",
      "statusCode": 308,
      "regex": "^(?!/_next)/termeni(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/[section]/[slug]",
      "regex": "^/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsection": "nxtPsection",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPsection>[^/]+?)/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/contact",
      "regex": "^/api/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/contact(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/privacy",
      "regex": "^/privacy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}